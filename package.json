{
  "name": "@moruteaven/matchabuild",
  "version": "0.1.0-dev.1",
  "description": "配置驱动的多端构建编排器：一条命令构建 web / uTools / ZTools / tauri / taro",
  "author": "MoruTeaven <me@MoruTeaven.com>",
  "license": "MIT",
  "keywords": [
    "build-tool",
    "monorepo",
    "vite",
    "taro",
    "tauri",
    "utools",
    "ztools"
  ],
  "type": "module",
  "bin": {
    "matcha": "./bin/matcha.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./utils": {
      "types": "./src/utils/index.d.ts",
      "import": "./src/utils/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.10",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
